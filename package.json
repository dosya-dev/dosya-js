{
  "name": "dosyadev",
  "version": "0.2.0",
  "description": "Official JavaScript SDK for dosya.dev - file storage, uploads, sharing, webhooks and workspace management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:unit"
  },
  "keywords": [
    "api-client",
    "cloud-storage",
    "dosya",
    "dosya.dev",
    "dosyadev",
    "file-storage",
    "file-upload",
    "sdk",
    "webhooks"
  ],
  "author": "dosya.dev",
  "license": "MIT",
  "homepage": "https://dosya.dev/developer/sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/dosya-dev/dosya-js"
  },
  "bugs": {
    "url": "https://github.com/dosya-dev/dosya-js/issues"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
